Grammar         ::= { NL | TopLevelDecl } EOF ;

TopLevelDecl    ::= PubOpt (StructDecl | FunctionDecl) ;
PubOpt          ::= "pub"? ;

StructDecl      ::= "struct" Identifier "{" { FieldDecl NL+ } "}" ;
FieldDecl       ::= PubOpt Identifier ":" Type ;

FunctionDecl    ::= Identifier "(" ParamListOpt ")" RetTypeOpt Block ;
ParamListOpt    ::= /* empty */ | Param { "," Param } ;
Param           ::= Identifier [ ":" Type ] ;
RetTypeOpt      ::= /* empty */ | "->" Type ;
Block           ::= "{" { Stmt NL* } "}" ;

Stmt            ::= IfStmt
                  | WhileStmt
                  | ForInLoop
                  | TryCatchStmt
                  | ReturnStmt
                  | BreakStmt
                  | ContinueStmt
                  | RaiseStmt
                  | ExpressionStmt ;

IfStmt          ::= "if" Expression Block [ "else" (IfStmt | Block) ] ;
WhileStmt       ::= "while" Expression Block ;
ForInLoop       ::= "for" Identifier "in" Expression Block ;
TryCatchStmt    ::= "try" Block "catch" [ Identifier ] Block ;

ReturnStmt      ::= "return" [ Expression ] NL ;
BreakStmt       ::= "break" NL ;
ContinueStmt    ::= "continue" NL ;
RaiseStmt       ::= "raise" Expression NL ;
ExpressionStmt  ::= Expression NL ;

Expression      ::= LogicalOr ;
LogicalOr       ::= LogicalAnd { "||" LogicalAnd } ;
LogicalAnd      ::= Equality  { "&&" Equality  } ;
Equality        ::= Relational { ( "==" | "!=" ) Relational } ;
Relational      ::= Additive  { ( "<" | "<=" | ">" | ">=" ) Additive } ;
Additive        ::= Multiplicative { ( "+" | "-" ) Multiplicative } ;
Multiplicative  ::= Unary { ( "*" | "/" | "%" ) Unary } ;
Unary           ::= ( "!" | "-" ) Unary | Postfix ;
Postfix         ::= Primary { "(" [ ArgList ] ")" | "." Identifier } ;
Primary         ::= Literal | Identifier | "(" Expression ")" ;
ArgList         ::= Expression { "," Expression } ;

Type            ::= Identifier | "any" | "int" | "uint" | "i8" | "i16" | "i32" | "i64"
                  | "u8" | "u16" | "u32" | "u64" | "bool" | "char" | "str" ;

Literal         ::= IntLiteral | BoolLiteral | CharLiteral | StringLiteral ;
IntLiteral      ::= /* lexer token Int */ ;
BoolLiteral     ::= "true" | "false" ;
CharLiteral     ::= /* lexer token Char */ ;
StringLiteral   ::= /* lexer token String */ ;